# Скопируйте в корень проекта как .env и заполните. Файл .env не попадает в git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

PEXELS_API_KEY=
PIXABAY_API_KEY=
# Wikimedia требует контактный email в запросах (правило для ботов)
WIKIMEDIA_CONTACT=

OPENAI_API_KEY=
OPENAI_BASE_URL=

OLLAMA_BASE_URL=

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET=

# Instagram Reels (Instagram Graph API, Facebook Login for Business). Токен и ID можно вставить
# в веб-интерфейсе: раздел «Публикация» → «Подключение Instagram». Токен в интерфейсе не показывается.
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Нужны только для автообновления долгого токена (60 дней) и показа срока его действия
META_APP_ID=
META_APP_SECRET=

TIKTOK_ACCESS_TOKEN=
